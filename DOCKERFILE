# Use an official Node.js LTS image (e.g., 18-alpine for smaller footprint)
FROM node:18-alpine

# Create and switch to a working directory
WORKDIR /app

# Copy only package.json and package-lock.json (if present)
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of your application's source code
COPY . .

# Build the application (compiles TypeScript, copies non-TS files to dist, etc.)
RUN npm run build

# Expose an application port (optional; adjust if you use a different port)
EXPOSE 3000

# Set the default command to run the app in "preview" mode (which executes dist/index.js)
CMD ["npm", "run", "preview"]
